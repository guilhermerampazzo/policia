# ============================================================
# FORJA v2 — variáveis de ambiente
# Copie para .env e ajuste. O docker-compose lê este arquivo.
# ============================================================

# Porta externa (única porta exposta no host / aaPanel).
# O app roda na porta 3000 internamente e é publicado nesta.
PORT_EXTERNA=10333

# Conexão com o banco (o Postgres roda em rede interna do compose).
# Se quiser usar um Postgres externo, aponte o DATABASE_URL para ele.
POSTGRES_DB=forja
POSTGRES_USER=forja
POSTGRES_PASSWORD=forja_segredo_troque
DATABASE_URL=postgresql://forja:forja_segredo_troque@db:5432/forja?schema=public

# Segredo da sessão (mínimo 32 caracteres). TROQUE em produção.
SESSION_PASSWORD=forja_mude_esta_senha_de_sessao_minimo_32_chars

# Credenciais criadas pelo seed (mude se quiser)
SEED_ADMIN_EMAIL=admin@forja.com
SEED_ADMIN_PASSWORD=forja1234
SEED_ALUNO_EMAIL=aluno@forja.com
SEED_ALUNO_PASSWORD=forja1234

# ------------------------------------------------------------
# IA (opcional) — endpoints compatíveis com OpenAI
# Sem chave, o sistema usa modos determinísticos (nunca quebra).
# ------------------------------------------------------------

# Mapa mental (endpoint do fornecedor de IA)
MINDMAP_API_KEY=
MINDMAP_BASE_URL=https://omni.codermaster.com.br/v1/
MINDMAP_MODEL=agy/gemini-3.6-flash-high

# Resumo de conteúdo (endpoint secundário)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1/
DEEPSEEK_MODEL=deepseek-v4-flash
